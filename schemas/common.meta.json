{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assets.opendaw.studio/community/schemas/common.meta.json",
  "title": "Fields shared by every meta.json",
  "type": "object",
  "required": ["name", "description", "author", "tags"],
  "properties": {
    "name": {"type": "string", "minLength": 1, "maxLength": 64},
    "description": {"type": "string", "minLength": 1, "maxLength": 1000},
    "author": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 64},
        "github": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "tags": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 32}
    }
  }
}
