{
  "name": "opendaw-commons-tools",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "tsx src/validate.ts --root ..",
    "test": "tsx --test test/*.test.ts",
    "lint": "tsc --noEmit",
    "build-indices": "tsx src/deploy.ts --root .. --build --out ../dist",
    "deploy": "tsx src/deploy.ts --root .. --build --upload"
  },
  "dependencies": {
    "@opendaw/lib-std": "0.0.88",
    "@opendaw/studio-adapters": "0.3.9",
    "@opendaw/studio-core-wasm": "0.0.22",
    "@opendaw/studio-scripting": "0.0.91",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "ssh2-sftp-client": "12.1.1",
    "tsx": "4.19.2",
    "typescript": "5.8.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "@types/ssh2-sftp-client": "9.0.5"
  }
}
